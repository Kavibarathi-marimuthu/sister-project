# Uzhavan AI Environment Variables
# Copy this file to .env.local and fill in your actual keys

# ──────────────────────────────────────────────
# FIREBASE AUTHENTICATION (required for Auth)
# Get these from Firebase Console > Project Settings > General > Your apps
# ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id_here

# ──────────────────────────────────────────────
# AI / LLM API KEY (for Tamil AI Voice Assistant + Crop Recommendations)
# Supports: OpenAI, Anthropic, Google Gemini, or any OpenAI-compatible API
# The app runs fully with mock data when this is not set
# ──────────────────────────────────────────────
VITE_AI_API_KEY=sk-your_ai_api_key_here
VITE_AI_MODEL=gpt-4o-mini
VITE_AI_BASE_URL=https://api.openai.com/v1

# ──────────────────────────────────────────────
# WEATHER API (for real weather data)
# Get from: https://openweathermap.org/api
# App works with mock weather data when not set
# ──────────────────────────────────────────────
VITE_WEATHER_API_KEY=your_openweathermap_api_key_here
VITE_WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ──────────────────────────────────────────────
# MAPS / GPS API (for farm boundary mapping)
# Get from: https://console.cloud.google.com (enable Maps JavaScript API)
# App shows a placeholder map when not set
# ──────────────────────────────────────────────
VITE_MAPS_API_KEY=your_google_maps_api_key_here

# ──────────────────────────────────────────────
# BACKEND API URL (for FastAPI backend)
# Leave empty to use mock data (no backend needed for demo)
# ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ──────────────────────────────────────────────
# DISEASE DETECTION (AI Computer Vision model)
# Can use Roboflow, HuggingFace, or custom CV model endpoint
# App uses mock diagnosis when not set
# ──────────────────────────────────────────────
VITE_DISEASE_MODEL_URL=https://your-cv-model-endpoint.com/predict

# ──────────────────────────────────────────────
# BACKEND (FastAPI server)
# These are for the FastAPI backend (uzhavan-ai/backend/)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/uzhavan_ai
SECRET_KEY=your_super_secret_key_here_min_32_chars
LLM_API_KEY=sk-your_ai_api_key_here
FIREBASE_ADMIN_CREDENTIALS_PATH=./firebase-admin-key.json
